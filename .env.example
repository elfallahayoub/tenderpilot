# TenderPilot — variables d'environnement
# Modele a copier en .env puis remplir. Ce fichier-ci EST versionne.
# Il ne contient aucune valeur secrete.

# --- Modele de raisonnement : orchestration, planification, arbitrages ---
LLM_URL=https://copilot-19.openai.azure.com/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.5

# --- Embeddings : indexation et recherche semantique (RAG) ---
EMBEDDING_MODEL=embedder-small-3
EMBEDDING_DIMENSIONS=512

# --- Modele a fort volume : extraction, classification, redaction, JSON ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://copilot-20.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_MAX_TOKENS=16384

# --- Infrastructure locale (noms de services Docker Compose) ---
DATABASE_URL=postgres://tenderpilot:tenderpilot@postgres:5432/tenderpilot
POSTGRES_USER=tenderpilot
POSTGRES_PASSWORD=tenderpilot
POSTGRES_DB=tenderpilot
REDIS_URL=redis://redis:6379

# --- Application ---
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
VITE_API_URL=http://localhost:3000
